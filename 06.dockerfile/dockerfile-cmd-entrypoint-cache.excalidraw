      "locked": false,
      "text": "- CMD: default command, replaced by run arguments\n- ENTRYPOINT: fixed program, run args are appended\n- Combine: ENTRYPOINT = program, CMD = default args\n- Replace ENTRYPOINT only with --entrypoint",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e38",
      "originalText": "- CMD: default command, replaced by run arguments\n- ENTRYPOINT: fixed program, run args are appended\n- Combine: ENTRYPOINT = program, CMD = default args\n- Replace ENTRYPOINT only with --entrypoint",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "ac",
      "created": null,
      "labelPosition": null,
