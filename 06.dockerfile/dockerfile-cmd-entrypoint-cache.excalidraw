      "updated": 1790677165745,
      "link": null,
      "locked": false,
      "text": "- The . in docker build is the build context\n- The whole folder is sent to the builder\n- COPY cannot reach files outside the context\n- Big context means slow builds\n- -f picks the Dockerfile, context stays the same",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e73",
      "originalText": "- The . in docker build is the build context\n- The whole folder is sent to the builder\n- COPY cannot reach files outside the context\n- Big context means slow builds\n- -f picks the Dockerfile, context stays the same",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b0B",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
