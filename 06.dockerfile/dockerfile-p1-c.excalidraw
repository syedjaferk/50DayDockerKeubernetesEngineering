      "boundElements": [],
      "updated": 1790677165745,
      "link": null,
      "locked": false,
      "text": "- Exec: JSON array, no shell, your app is PID 1\n- Shell: plain text, runs via /bin/sh -c\n- Exec gets signals but no $VAR expansion\n- Shell expands $VAR but may swallow signals\n- Prefer exec form for CMD and ENTRYPOINT",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "e67",
      "originalText": "- Exec: JSON array, no shell, your app is PID 1\n- Shell: plain text, runs via /bin/sh -c\n- Exec gets signals but no $VAR expansion\n- Shell expands $VAR but may swallow signals\n- Prefer exec form for CMD and ENTRYPOINT",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b05",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
